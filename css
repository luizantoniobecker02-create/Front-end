:root {

    --pumpkim-orange: #ee5622;
    --dark-purple: #432534;
    --beige: #efd6ac;
    --pastel-violet: #7678ed;
    --blood-red: #9a031e;

    --cor-primaria: #3498db;
    --cor-secundaria: #6c757d;
    --cor-sucesso: #28a745;
    --cor-aviso: #ffc107;
    --cor-erro: #dc3545;

    --cor-texto-preto: #0A090C;
    --cor-texto-cinza: #313131;
    --cor-texto-branco: #FFFFFF;

    --font-de-legenda: "Arial";

    --font-principal: 'Roboto', sans-serif;
    --font-secundaria: 'Noto Sans', sans-serif;

}


/* RESET */

* {

    padding: 0;
    margin: 0;

    box-sizing: border-box;

}


/* CORPO */

body {

    font-family: var(--font-principal);

    background-color: var(--dark-purple);

    color: var(--cor-texto-branco);

}


/* MENU */

.menu {

    background-color: var(--pumpkim-orange);

    width: 100%;

    padding: 15px 40px;

    display: flex;

    align-items: center;

    justify-content: space-between;

    position: relative;

}


/* LOGO */

.brand {

    font-size: 26pt;

    color: var(--cor-texto-preto);

}


/* LINKS DO MENU */

.menu-elementos {

    display: flex;

    align-items: center;

    gap: 10px;

}


.menu-elementos a {

    padding: 10px 16px;

    text-decoration: none;

    color: var(--cor-texto-preto);

    font-size: 14pt;

    font-weight: bold;

    transition: 0.3s;

}


.menu-elementos a:hover {

    background-color: var(--dark-purple);

    color: var(--cor-texto-branco);

    border-radius: 8px;

}


/* BANNER */

.banner {

    width: 100%;

    margin: 0;

    padding: 0;

}


.banner-img {

    width: 100%;

    height: 450px;

    object-fit: cover;

    object-position: center;

    display: block;

    border-radius: 0;

}


/* CONTAINER */

.container {

    max-width: 1100px;

    width: 90%;

    margin: auto;

}


/* SEÇÕES */

section {

    padding: 25px 0;

}


/* TÍTULOS */

.sub-titulo {

    font-size: 24pt;

    color: var(--pumpkim-orange);

    margin: 0 0 20px 0;

    border-left: 5px solid var(--pumpkim-orange);

    padding-left: 15px;

}


/* CONTEÚDO */

.sobre-conteudo {

    background-color: #30202c;

    padding: 25px 30px;

    margin: 0 0 25px 0;

    border-radius: 12px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);

    line-height: 1.6;

}


/* LISTAS */

.sobre-conteudo ul,
.sobre-conteudo ol {

    padding-left: 25px;

}


.sobre-conteudo li {

    margin-bottom: 8px;

}


/* ========================= */
/* PERGUNTAS E RESPOSTAS */
/* ========================= */

.pergunta {

    margin-bottom: 35px;

}


.pergunta:last-child {

    margin-bottom: 0;

}


.pergunta strong {

    display: block;

    font-size: 16pt;

    color: var(--cor-texto-branco);

    margin-bottom: 15px;

}


.pergunta .resposta {

    display: block;

    margin: 0;

    padding: 0;

    color: var(--beige);

    font-size: 13pt;

    line-height: 1.7;

}


/* ========================= */
/* ATRAÇÕES */
/* ========================= */

#atracoes {

    padding: 30px 0 20px 0;

}


/* ========================= */
/* SOBRE */
/* ========================= */

#sobre {

    padding: 20px 0;

}


/* ============================= */
/* CONTATO */
/* ============================= */

.contatos {
    display: flex;
    flex-direction: column;
    gap: 25px;
    color: var(--pumpkim-orange);

    width: 100%;

    text-align: left;
}

/* Cada contato dentro do mesmo bloco */

.contato {
    display: flex;
    align-items: center;
    gap: 20px;
}

.contato i {
    margin: 0;

    color: var(--pumpkim-orange);
    font-size: 30pt;
}

.contato h3 {
    margin-bottom: 5px;

    color: var(--pumpkim-orange);
    font-size: 16pt;
}

.contato p {
    color: var(--beige);
    font-size: 13pt;
}

/* ========================= */
/* MENU HAMBÚRGUER */
/* ========================= */

.menu-toggle {

    display: none;

}


.btn-menu {

    display: none;

    font-size: 28px;

    color: var(--cor-texto-preto);

    cursor: pointer;

    padding: 5px;

}


.icone-abrir {

    display: block;

}


.icone-fechar {

    display: none;

}


/* ========================= */
/* RODAPÉ */
/* ========================= */

footer {

    background-color: var(--pumpkim-orange);

    padding: 30px;

    text-align: center;

    color: var(--cor-texto-preto);

}


/* ========================= */
/* RESPONSIVIDADE */
/* ========================= */

@media (max-width: 768px) {


    /* MENU */

    .menu {

        flex-direction: row;

        align-items: center;

        justify-content: space-between;

        padding: 15px 20px;

    }


    /* BOTÃO */

    .btn-menu {

        display: block;

    }


    /* LINKS */

    .menu-elementos {

        position: absolute;

        top: 100%;

        left: 0;

        width: 100%;

        background-color: var(--pumpkim-orange);

        display: flex;

        flex-direction: column;

        align-items: stretch;

        gap: 0;

        max-height: 0;

        overflow: hidden;

        opacity: 0;

        visibility: hidden;

        transition: max-height 0.3s ease,
                    opacity 0.3s ease,
                    visibility 0.3s ease;

        z-index: 1000;

    }


    .menu-elementos a {

        width: 100%;

        padding: 15px 20px;

        text-align: center;

        border-radius: 0;

        border-bottom: 1px solid rgba(0, 0, 0, 0.15);

    }


    /* ABRIR MENU */

    .menu-toggle:checked ~ .menu-elementos {

        max-height: 400px;

        opacity: 1;

        visibility: visible;

    }


    /* TROCAR ÍCONE */

    .menu-toggle:checked ~ .btn-menu .icone-abrir {

        display: none;

    }


    .menu-toggle:checked ~ .btn-menu .icone-fechar {

        display: block;

    }


    /* BANNER */

    .banner-img {

        height: 280px;

    }


    /* CONTAINER */

    .container {

        width: 90%;

    }


    /* SEÇÕES */

    section {

        padding: 20px 0;

    }


    /* TÍTULOS */

    .sub-titulo {

        font-size: 18pt;

    }


    /* CONTEÚDO */

    .sobre-conteudo {

        padding: 20px;

    }


    /* PERGUNTAS */

    .pergunta {

        margin-bottom: 30px;

    }


    .pergunta strong {

        font-size: 14pt;

        margin-bottom: 12px;

    }


    .pergunta .resposta {

        font-size: 12pt;

    }


    /* CONTATOS */

    .contatos {

        flex-direction: column;

        align-items: center;

        gap: 20px;

    }

}
