:root {
    --pumpkim-orange: #ee5622;
    --dark-purple: #432534;
    --beige: #efd6ac;
    --pastel-violet: #7678ed;
    --blood-red: #9a031e;

    --cor-primaria: #3498db;
    --cor-secundaria: #6c757d;
    --cor-sucesso: #28a745;
    --cor-aviso: #ffc107;
    --cor-erro: #dc3545;

    --cor-texto-preto: #0A090C;
    --cor-texto-cinza: #313131;
    --cor-texto-branco: #FFFFFF;

    --font-de-legenda: "Arial";


    --font-principal: 'Roboto', sans-serif;
    --font-secundaria: 'Noto sans', sans-serif;
}


* {
    padding: 0px;
    margin: 0px;
    box-sizing: border-box;
}

body {
    font-family: var(--font-principal);
}

.container {
    max-width: 1000px;
    width: 100%;
    margin: auto;
}

.menu {
    background-color: var(--pumpkim-orange);
    width: 100%;
    max-width: 1920px;
    margin: auto;
    color: var(--cor-texto-preto);
    float: left;
}

.brand {
    font-size: 22pt;
    width: 50px;
    float: left;
}

.menu-elementos {
    width: 500px;
    float: left;
}

.menu-elementos a {
    padding: 10px;
    text-decoration: none;
    color: var(--cor-texto-preto);
    font-size: 18pt;
}

.banner-img {
    width: 100%;
    height: 100%;
}

.bloco {
    width: 200px;
    float: left;
}

.btn-menu {
    display: none;
}

.menu-toogle {
    display: none;
}

.menu-elementos {
    display: flex;
    align-items: center;
    gap: 12px;
}

.menu-link {
    padding: 10px 16px;
    text-decoration: none;
    color: var(--cor-texto-preto);
    font-size: 14pt;
}

@media (max-width: 768px) {
    .btn-menu {
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #0A090C;
        font-size: 24pt;
        padding: 6px;
        border-radius: 6px;
        user-select: none;
        transition: background-color 0.2s ease, color 0.2s;
    }
    .btn-menu:hover {
    background-color: var(--pumpkim-orange);
    color: var(#7678ed);
}

.btn-menu .icone-abrir {
    display: block;
}

.btn-menu .icone-fechar {
    display: none;
}

.menu-elementos {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #28a745;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    visibility: hidden;
    transition: max-height 0.35s ease, opacity 0.3s ease, visibility 0.35s ease, padding 0.3s ease;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 10px 25px rgba(0,0,0,0.6);
    z-index: 1000;
}

.menu-toggle:checked~.btn-menu .icone-abrir{
    display: none;
}

.menu-toggle:checked~.btn-menu .icone-fechar{
    display: block;
}

.menu-link{
    padding: 14px 24px;
    font-size: 13pt;
    border-radius: 0;
    border-left: 4px solid transparent;
    display: block;
}

.menu-link:hover,
.menu-link:focus{
    background-color: #28a745;
    border-left-color: var(--cor-erro);
    padding-left: 28px;
    transform: none;
}

}


